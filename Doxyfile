PROJECT_NAME           = "XL++"
PROJECT_BRIEF          = "High-performance C++20 Excel XLSX read/write library"
PROJECT_NUMBER         = 1.0.0
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

INPUT                  = include docs/doxygen-mainpage.md
FILE_PATTERNS          = *.h
RECURSIVE              = YES
EXCLUDE                = third_party bindings

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
USE_MDFILE_AS_MAINPAGE = docs/doxygen-mainpage.md
MARKDOWN_SUPPORT       = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
QUIET                  = NO
WARN_AS_ERROR          = NO

GENERATE_TREEVIEW      = YES
HTML_TIMESTAMP         = NO
HAVE_DOT               = NO
